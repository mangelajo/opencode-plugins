{
  "name": "@fazaboa/opencode-plugins",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.2.0",
  "description": "OpenCode plugins: thinking-guard (anti-loop) and truncation detection.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "auto-continue",
    "thinking-guard",
    "truncation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fazaboa/opencode-plugins.git"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
